DATABASE_URL=postgres://opsdeck:opsdeck@localhost:5433/opsdeck
REDIS_URL=redis://localhost:6380
CHECK_INTERVAL_MS=15000
CHECK_TIMEOUT_MS=5000
LOG_LEVEL=info

# Host ports for local tools (defaults avoid clashing with a local Postgres/Redis)
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# Admin key for write endpoints (local default shown; production uses a generated secret)
ADMIN_API_KEY=local-dev-admin-key
