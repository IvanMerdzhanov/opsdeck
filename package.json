{
  "name": "opsdeck",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "up": "docker compose up --build",
    "down": "docker compose down -v",
    "smoke": "bash scripts/smoke.sh",
    "migrate": "node --env-file=.env db/migrate.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "globals": "^16.3.0",
    "supertest": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
